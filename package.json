{
  "name": "news-site",
  "version": "1.0.0",
  "description": "Local LLM News Digest - Static Site",
  "scripts": {
    "build": "node scripts/prebuild.js && next build",
    "dev": "next dev",
    "start": "next start",
    "deploy:cf": "npm run build && wrangler pages deploy out/ --project-name=news-site",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "next": "^16.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "wrangler": "^4.122.0"
  },
  "allowScripts": {
    "workerd@1.20260811.1": true,
    "esbuild@0.28.1": true
  }
}
